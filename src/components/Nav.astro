---
import { profile } from '../data/site';

const links = [
  { href: '#about', label: 'About' },
  { href: '#stack', label: 'Stack' },
  { href: '#experience', label: 'Work' },
  { href: '#articles', label: 'Writing' },
  { href: '#contact', label: 'Contact' },
];
---

<nav>
  <div class="nav-inner">
    <a href="#top" class="nav-logo">José Marciano<span>.</span></a>
    <div class="nav-links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
    <a
      class="nav-gh"
      href={profile.links.github}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.5 11.5 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
        ></path>
      </svg>
    </a>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    background: rgba(10, 16, 24, 0.85);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 32px;
    height: 58px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nav-logo {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
    margin-right: auto;
  }
  .nav-logo span {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    gap: 2px;
  }
  .nav-links a {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    padding: 6px 12px;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
  }
  .nav-links a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-gh {
    display: inline-flex;
    align-items: center;
    color: var(--text-subtle);
    padding: 6px;
    border-radius: 6px;
    transition: color 0.15s;
  }
  .nav-gh:hover {
    color: var(--accent);
  }

  @media (max-width: 680px) {
    .nav-inner {
      padding: 0 20px;
    }
    .nav-links {
      display: none;
    }
  }
</style>
