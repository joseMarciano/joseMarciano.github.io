---
import { profile } from '../data/site';
---

<header id="top" class="hero">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-content">
    <p class="eyebrow">{profile.eyebrow}</p>
    <h1>{profile.name}</h1>
    <p class="hero-bio">
      I build the backends that move money, and keep them <span class="hl">fast</span> without dropping the safe part. Seven years in Go and distributed systems, most of it in fintech.
    </p>

    <div class="links">
      <a href={profile.links.github} target="_blank" rel="noopener noreferrer">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.5 11.5 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        GitHub
      </a>
      <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
        LinkedIn
      </a>
      <a href={profile.links.medium} target="_blank" rel="noopener noreferrer">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"
          ></path>
        </svg>
        Medium
      </a>
      <a href={`mailto:${profile.email}`}>
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        Email
      </a>
      <a class="resume" href={profile.resume} download>
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3v11"></path>
          <path d="m7 10 5 5 5-5"></path>
          <path d="M5 20h14"></path>
        </svg>
        Resume
      </a>
    </div>
  </div>

  <div class="avatar">
    <div class="avatar-ring">
      <div class="avatar-inner">
        <img class="avatar-photo" src="/profile.jpg" alt="José Marciano" width="248" height="248" />
      </div>
    </div>
    <span class="avatar-status">
      <span class="avatar-dot"></span>
      Available
    </span>
  </div>
</header>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 88px 32px 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 64px;
  }

  .hero-glow {
    position: absolute;
    top: -180px;
    right: -160px;
    width: 760px;
    height: 760px;
    background: radial-gradient(circle, rgba(56, 226, 176, 0.06) 0%, transparent 56%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    flex: 1;
    min-width: 0;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.08em;
    margin-bottom: 18px;
  }

  h1 {
    font-size: clamp(2.1rem, 5vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    margin-bottom: 22px;
    color: var(--text);
  }

  .hero-bio {
    font-size: 1.02rem;
    color: var(--text-muted);
    line-height: 1.75;
    max-width: 540px;
  }
  .hero-bio .hl {
    color: var(--accent-2);
    font-weight: 500;
  }

  .links {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-muted);
    padding: 8px 16px;
    border: 1px solid var(--border);
    border-radius: 99px;
    background: var(--bg-surface);
    transition: color 0.15s, border-color 0.15s, background 0.15s, transform 0.15s;
  }
  .links a:hover {
    color: var(--text);
    border-color: var(--accent-border);
    background: var(--accent-glow);
    transform: translateY(-1px);
  }
  .links a.resume {
    color: var(--accent);
    border-color: var(--accent-border);
    background: var(--accent-glow);
    font-weight: 600;
  }
  .links a.resume:hover {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  /* Avatar */
  .avatar {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .avatar-ring {
    width: 248px;
    height: 248px;
    border-radius: 50%;
    padding: 2px;
    background: linear-gradient(140deg, var(--accent-border), var(--border) 58%);
  }
  .avatar-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-card);
  }
  .avatar-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    display: block;
  }
  .avatar-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .avatar-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  @media (max-width: 760px) {
    .hero {
      padding: 56px 20px 60px;
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 32px;
    }
    .avatar {
      flex-direction: row;
      gap: 16px;
    }
    .avatar-ring {
      width: 92px;
      height: 92px;
    }
  }
</style>
