---
// Articles are fetched client-side from /articles.json, which is generated by
// fetch_articles.py (Medium + dev.to RSS + articles-manual.json) on a schedule.
---

<section id="articles" class="section">
  <div class="section-wrapper">
    <div class="section-header">
      <span class="section-label">Writing</span>
      <h2 class="section-title">Latest articles</h2>
      <div class="section-line"></div>
    </div>
    <div
      id="articles-grid"
      class="articles-grid"
      data-min-read="min read"
      data-error="Couldn't load articles right now. Find them on Medium."
      data-locale="en-US"
    >
    </div>
  </div>
</section>

<style>
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  @media (max-width: 880px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  type RawArticle = {
    title: string;
    link: string;
    pubDate: string;
    description?: string;
    content?: string;
    cover_image?: string;
    source?: string;
    tags?: string[];
  };

  function extractThumb(item: RawArticle): string | null {
    if (item.cover_image) return item.cover_image;
    const html = item.content || item.description || '';
    const m = html.match(/<img[^>]+src="([^"]+)"/);
    return m ? m[1] : null;
  }

  function stripHtml(html: string): string {
    return (html || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  }

  function estimateReadTime(text: string, label: string): string {
    const words = stripHtml(text).split(/\s+/).filter(Boolean).length;
    const mins = Math.max(1, Math.round(words / 200));
    return `${mins} ${label}`;
  }

  function formatDate(dateStr: string, locale: string): string {
    try {
      return new Date(dateStr).toLocaleDateString(locale, {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });
    } catch {
      return '';
    }
  }

  function sourceLabel(source: string): string {
    if (source === 'devto') return 'DEV.to';
    if (source === 'linkedin') return 'LinkedIn';
    if (source === 'medium') return 'Medium';
    return source.charAt(0).toUpperCase() + source.slice(1);
  }

  function formatTag(tag: string): string {
    return tag.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function toSentence(text: string, max: number): string {
    if (text.length <= max) return text;
    const chunk = text.slice(0, max);
    const end = Math.max(chunk.lastIndexOf('.'), chunk.lastIndexOf('!'), chunk.lastIndexOf('?'));
    return end > 60 ? text.slice(0, end + 1) : chunk.trimEnd() + '…';
  }

  const grid = document.getElementById('articles-grid');
  if (grid) {
    const minRead = grid.dataset.minRead || 'min read';
    const locale = grid.dataset.locale || 'en-US';
    const errorMsg = grid.dataset.error || 'Could not load articles.';

    grid.innerHTML = Array.from(
      { length: 6 },
      () => `
      <div class="skeleton">
        <div class="skeleton-thumb"></div>
        <div class="skeleton-body">
          <div class="skeleton-line" style="width:40%"></div>
          <div class="skeleton-line" style="width:85%"></div>
          <div class="skeleton-line" style="width:65%"></div>
        </div>
      </div>`
    ).join('');

    fetch('/articles.json')
      .then((r) => {
        if (!r.ok) throw new Error('not ok');
        return r.json();
      })
      .then((all: RawArticle[]) => {
        const articles = all.slice(0, 6);
        if (!articles.length) {
          grid.innerHTML = `<p style="color:var(--text-muted);grid-column:1/-1">${errorMsg}</p>`;
          return;
        }
        grid.innerHTML = articles
          .map((item) => {
            const thumb = extractThumb(item);
            const source = item.source || 'medium';
            const tags = (item.tags ?? []).slice(0, 3);
            const rich =
              item.description && item.description.trim()
                ? item.description
                : stripHtml(item.content || '');
            const plain = stripHtml(rich);
            const excerpt = escapeHtml(toSentence(plain, 180));
            const title = escapeHtml(item.title);

            return `
              <a class="article" href="${item.link}" target="_blank" rel="noopener noreferrer">
                ${
                  thumb
                    ? `<img class="article-thumb" src="${thumb}" alt="${title}" loading="lazy" />`
                    : `<div class="article-thumb-placeholder">${title.slice(0, 2)}</div>`
                }
                <div class="article-body">
                  <div class="article-tags">
                    <span class="platform-badge" data-source="${source}">${sourceLabel(source)}</span>
                    ${tags.map((tag) => `<span class="article-tag">${escapeHtml(formatTag(tag))}</span>`).join('')}
                  </div>
                  <div class="article-title">${title}</div>
                  <div class="article-excerpt">${excerpt}</div>
                  <div class="article-footer">
                    <span class="article-date">${formatDate(item.pubDate, locale)}</span>
                    <span class="article-readtime">${estimateReadTime(plain, minRead)}</span>
                  </div>
                </div>
              </a>`;
          })
          .join('');
      })
      .catch(() => {
        grid.innerHTML = `<p style="color:var(--text-muted);grid-column:1/-1">${errorMsg}</p>`;
      });
  }
</script>
