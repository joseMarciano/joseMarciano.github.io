---
import { experience, education } from '../data/site';
---

<section id="experience" class="section">
  <div class="section-wrapper">
    <div class="section-header">
      <span class="section-label">Work</span>
      <h2 class="section-title">Experience</h2>
      <div class="section-line"></div>
    </div>

    <div class="exp">
      <div class="tab-list" role="tablist" aria-label="Companies">
        {
          experience.map((entry, i) => (
            <button
              class={`tab-btn${i === 0 ? ' active' : ''}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-index={i}
            >
              {entry.company}
            </button>
          ))
        }
        <div class="tab-indicator" aria-hidden="true"></div>
      </div>

      <div class="tab-panels">
        {
          experience.map((entry, i) => (
            <div class={`tab-panel${i === 0 ? ' active' : ''}`} role="tabpanel" data-index={i}>
              <h3 class="panel-role">
                {entry.role}
                <span class="panel-company"> @ {entry.company}</span>
              </h3>
              <div class="panel-meta">
                <span class="panel-period">{entry.period}</span>
                <span class="panel-place">{entry.place}</span>
                {entry.current && <span class="current-badge">Current</span>}
              </div>
              <p class="panel-desc">{entry.description}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="edu">
      <span class="edu-label">Education</span>
      <ul class="edu-list">
        {
          education.map((e) => (
            <li>
              <span class="edu-title">{e.title}</span>
              <span class="edu-org">{e.org}</span>
              <span class="edu-year">{e.year}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .exp {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 0 44px;
    min-height: 260px;
  }

  .tab-list {
    position: relative;
    display: flex;
    flex-direction: column;
    border-left: 2px solid var(--border);
  }
  .tab-btn {
    all: unset;
    cursor: pointer;
    padding: 11px 18px;
    font-size: 0.84rem;
    color: var(--text-subtle);
    transition: color 0.2s, background 0.2s;
    border-radius: 0 5px 5px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tab-btn:hover {
    color: var(--accent);
    background: var(--accent-glow);
  }
  .tab-btn.active {
    color: var(--accent);
  }
  .tab-indicator {
    position: absolute;
    left: -2px;
    width: 2px;
    background: var(--accent);
    border-radius: 2px;
    transition: top 0.25s cubic-bezier(0.4, 0, 0.2, 1), height 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .tab-panels {
    position: relative;
  }
  .tab-panel {
    display: none;
    flex-direction: column;
    gap: 14px;
    animation: fadeIn 0.2s ease;
  }
  .tab-panel.active {
    display: flex;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .panel-role {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .panel-company {
    color: var(--accent);
    font-weight: 500;
  }

  .panel-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .panel-period {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-subtle);
    letter-spacing: 0.02em;
  }
  .panel-place {
    font-size: 0.76rem;
    color: var(--text-subtle);
  }
  .panel-place::before {
    content: '·';
    margin-right: 10px;
    color: var(--border-hover);
  }
  .current-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-glow);
    border: 1px solid var(--accent-border);
    border-radius: 99px;
    padding: 2px 8px;
  }

  .panel-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.75;
    max-width: 600px;
  }

  /* Education */
  .edu {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .edu-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
  .edu-list {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .edu-list li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: 14px;
  }
  .edu-title {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text);
  }
  .edu-org {
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .edu-year {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .exp {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .tab-list {
      flex-direction: row;
      overflow-x: auto;
      border-left: none;
      border-bottom: 2px solid var(--border);
      scrollbar-width: none;
    }
    .tab-list::-webkit-scrollbar {
      display: none;
    }
    .tab-btn {
      padding: 9px 14px;
      border-radius: 5px 5px 0 0;
    }
    .tab-indicator {
      left: 0;
      bottom: -2px;
      top: auto !important;
      height: 2px !important;
      transition: left 0.25s cubic-bezier(0.4, 0, 0.2, 1), width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .tab-panels {
      padding-top: 24px;
    }
    .edu-list li {
      grid-template-columns: 1fr auto;
    }
    .edu-org {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>

<script>
  function initTabs() {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab-btn'));
    const panels = document.querySelectorAll<HTMLElement>('.tab-panel');
    const indicator = document.querySelector<HTMLElement>('.tab-indicator');
    if (!buttons.length || !indicator) return;

    const isMobile = () => window.innerWidth <= 640;

    function moveIndicator(btn: HTMLButtonElement) {
      if (isMobile()) {
        indicator!.style.left = btn.offsetLeft + 'px';
        indicator!.style.width = btn.offsetWidth + 'px';
        indicator!.style.height = '2px';
        indicator!.style.top = 'auto';
      } else {
        indicator!.style.top = btn.offsetTop + 'px';
        indicator!.style.height = btn.offsetHeight + 'px';
        indicator!.style.width = '2px';
      }
    }

    function activate(index: number) {
      buttons.forEach((b, i) => {
        b.classList.toggle('active', i === index);
        b.setAttribute('aria-selected', i === index ? 'true' : 'false');
      });
      panels.forEach((p, i) => p.classList.toggle('active', i === index));
      moveIndicator(buttons[index]);
    }

    buttons.forEach((btn, i) => btn.addEventListener('click', () => activate(i)));
    activate(0);

    let raf = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const active = buttons.findIndex((b) => b.classList.contains('active'));
        if (active >= 0) moveIndicator(buttons[active]);
      });
    });
  }

  initTabs();
</script>
